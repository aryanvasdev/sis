---
import '../styles/global.css';
import PreviewBanner from '../components/PreviewBanner.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import NewsTicker from '../components/NewsTicker.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { school } from '../data/school';
import { url } from '../lib/url';

interface Props {
  /** Page title. Leave empty on the home page. */
  title?: string;
  description?: string;
  /** Show the scrolling "Latest updates" bar under the header. */
  ticker?: boolean;
}

const {
  title,
  description = `${school.name}, ${school.address.city} (${school.address.district}): a ${school.type.toLowerCase()} for ${school.classes}, following the ${school.curriculum}. ${school.tagline}`,
  ticker = false,
} = Astro.props;

const pageTitle = title
  ? `${title} | ${school.name}`
  : `${school.name} | School in ${school.address.city}, ${school.address.district}`;
const ogImage = new URL(url('/images/og-image.jpg'), Astro.site);
const pathname = /\/$|\.[a-z]+$/i.test(Astro.url.pathname) ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, Astro.site);
const isHome = !title;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'School',
  name: school.name,
  url: new URL(url('/'), Astro.site).href,
  logo: new URL(url('/images/logo.webp'), Astro.site).href,
  foundingDate: String(school.established),
  telephone: school.phones[0],
  email: school.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: [school.address.line1, school.address.line2].filter(Boolean).join(', '),
    addressLocality: school.address.city,
    addressRegion: school.address.state,
    postalCode: school.address.pincode,
    addressCountry: 'IN',
  },
  sameAs: Object.values(school.social).filter(Boolean),
};
---

<!doctype html>
<html lang="en-IN" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="64x64" href={url('/favicon-64.png')} />
    <link rel="icon" type="image/png" sizes="32x32" href={url('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#0a1f44" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={school.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <PreviewBanner />
    <TopBar />
    <Header />
    {ticker && <NewsTicker />}
    <main id="main">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />

    <script>
      // "Upcoming events" lists: hide events that have ended since the site was last built.
      const now = new Date();
      const today = [now.getFullYear(), now.getMonth() + 1, now.getDate()].map((n) => String(n).padStart(2, '0')).join('-');
      document.querySelectorAll<HTMLElement>('[data-events]').forEach((list) => {
        const max = Number(list.dataset.max) || Infinity;
        let shown = 0;
        list.querySelectorAll<HTMLElement>('[data-ends]').forEach((item) => {
          const keep = (item.dataset.ends ?? '') >= today && shown < max;
          item.hidden = !keep;
          if (keep) shown++;
        });
        const empty = list.parentElement?.querySelector<HTMLElement>('[data-events-empty]');
        if (empty) empty.hidden = shown > 0;
      });

      // Fade sections in as they scroll into view.
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
