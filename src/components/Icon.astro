---
/**
 * <Icon name="graduation-cap" />
 * Any icon from https://lucide.dev/icons works, plus the brand icons below.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
  strokeWidth?: number;
}

const { name, size = 24, class: className, label, strokeWidth = 2 } = Astro.props;

const brands: Record<string, string> = {
  facebook:
    '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21.95V14.2h2.6l.4-3.03h-3V9.24c0-.88.25-1.47 1.5-1.47h1.6V5.06a21 21 0 0 0-2.33-.12c-2.3 0-3.88 1.4-3.88 3.98v2.25H7.8v3.03h2.6v7.75A10 10 0 1 1 13.5 21.95Z"/></svg>',
  instagram:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.6" cy="6.4" r="1" fill="currentColor" stroke="none"/></svg>',
  youtube:
    '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8ZM9.75 15.02V8.98L15.5 12l-5.75 3.02Z"/></svg>',
  whatsapp:
    '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48a9 9 0 0 1-1.66-2.06c-.17-.3-.02-.46.13-.6.13-.14.3-.35.44-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.48.71.31 1.27.5 1.7.63.72.23 1.37.2 1.88.12.58-.09 1.75-.72 2-1.41.25-.7.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35M12.04 21.5h-.01a9.4 9.4 0 0 1-4.8-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.44 9.44 0 0 1-1.45-5.03c0-5.2 4.24-9.44 9.45-9.44a9.4 9.4 0 0 1 9.43 9.45c0 5.21-4.24 9.44-9.45 9.44m8.04-17.48A11.3 11.3 0 0 0 12.04.7C5.77.7.66 5.8.66 12.06c0 2 .53 3.96 1.52 5.68L.57 23.62l6.03-1.58a11.4 11.4 0 0 0 5.43 1.38h.01c6.27 0 11.37-5.1 11.38-11.36A11.3 11.3 0 0 0 20.08 4"/></svg>',
};

const lucide = import.meta.glob<string>('/node_modules/lucide-static/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

let svg = brands[name] ?? lucide[`/node_modules/lucide-static/icons/${name}.svg`];
if (!svg) throw new Error(`Icon "${name}" not found. Browse names at https://lucide.dev/icons`);

// Rewrite only the root <svg> tag: child shapes (e.g. <rect width>) must keep their attributes.
svg = svg
  .replace(/<!--[\s\S]*?-->/g, '')
  .trim()
  .replace(/^<svg[^>]*>/, (tag) =>
    tag
      .replace(/\s(width|height|class)="[^"]*"/g, '')
      .replace(/stroke-width="[^"]*"/, `stroke-width="${strokeWidth}"`)
      .replace(
        '<svg',
        `<svg width="${size}" height="${size}" class="icon${className ? ` ${className}` : ''}" ${
          label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"'
        }`,
      ),
  );
---

<Fragment set:html={svg} />
