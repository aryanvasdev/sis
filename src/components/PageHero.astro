---
/**
 * Banner at the top of every inner page, with breadcrumbs.
 *
 * <PageHero title="Admissions" eyebrow="Session 2027–28" lead="…" crumbs={[{ label: 'Admissions' }]} />
 * Anything passed as children is rendered under the lead (e.g. buttons).
 */
import Icon from './Icon.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  crumbs?: { label: string; href?: string }[];
}

const { title, eyebrow, lead, crumbs = [{ label: title }] } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <nav aria-label="Breadcrumb">
      <ol class="crumbs">
        <li><a href={url('/')}>Home</a></li>
        {
          crumbs.map((c, i) => (
            <li>
              <Icon name="chevron-right" size={14} />
              {c.href && i < crumbs.length - 1 ? (
                <a href={url(c.href)}>{c.label}</a>
              ) : (
                <span aria-current="page">{c.label}</span>
              )}
            </li>
          ))
        }
      </ol>
    </nav>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(44px, 7vw, 88px) clamp(48px, 7vw, 84px);
    background:
      radial-gradient(900px 400px at 85% -10%, rgb(212 161 42 / 0.22), transparent 60%),
      linear-gradient(135deg, var(--navy-900), var(--navy-800) 55%, var(--navy-700));
    color: #dfe6f3;
  }
  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--jali);
    background-size: 64px 64px;
    opacity: 0.08;
    mask-image: linear-gradient(90deg, transparent 30%, #000);
  }
  .page-hero::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 5px;
    background: linear-gradient(90deg, var(--gold-600), var(--gold-400), var(--gold-600));
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin-bottom: 22px;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .crumbs a {
    color: #b9c6df;
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--gold-400);
  }
  .crumbs [aria-current] {
    color: var(--gold-400);
  }
  .crumbs :global(.icon) {
    opacity: 0.5;
  }
  .eyebrow {
    color: var(--gold-400);
  }
  h1 {
    color: #fff;
    margin-top: 10px;
    font-size: var(--step-5);
    max-width: 20ch;
  }
  .lead {
    color: #c7d2e6;
  }
  .page-hero :global(.btn-row) {
    margin-top: 28px;
  }
</style>
