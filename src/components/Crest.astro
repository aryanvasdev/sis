---
/**
 * The school logo.
 *  - variant="emblem" (default): the shield, cap and laurels only, for small sizes.
 *  - variant="full": the complete logo with the "Sahib International School, Saha – Ambala" ribbon.
 * `size` is the rendered height in pixels.
 */
import { url } from '../lib/url';

interface Props {
  size?: number;
  variant?: 'emblem' | 'full';
  class?: string;
  alt?: string;
}

const { size = 56, variant = 'emblem', class: className, alt = '' } = Astro.props;

const logos = {
  emblem: { src: '/images/emblem.webp', width: 343, height: 260 },
  full: { src: '/images/logo.webp', width: 560, height: 502 },
};
const logo = logos[variant];
const width = Math.round((size * logo.width) / logo.height);
---

<img src={url(logo.src)} alt={alt} width={width} height={size} class={className} decoding="async" />
