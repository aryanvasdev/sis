---
import Crest from './Crest.astro';
import Icon from './Icon.astro';
import { school, telLink, whatsappLink } from '../data/school';
import { mainNav, utilityLinks } from '../data/navigation';
import { url, isCurrent } from '../lib/url';

const path = Astro.url.pathname;
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a href={url('/')} class="brand" aria-label={`${school.name}, home`}>
      <Crest size={48} class="brand-crest" />
      <span class="brand-text">
        <span class="brand-name">{school.name}</span>
        <span class="brand-sub">CBSE Affiliated · {school.classes}</span>
      </span>
    </a>

    <nav class="nav-desktop" aria-label="Main">
      <ul>
        {
          mainNav.map((item) => (
            <li class:list={[{ 'has-menu': item.children }]}>
              <a href={url(item.href)} aria-current={isCurrent(item.href, path) ? 'page' : undefined}>
                {item.label}
                {item.children && <Icon name="chevron-down" size={14} />}
              </a>
              {item.children && (
                <ul class="menu">
                  {item.children.map((child) => (
                    <li>
                      <a href={url(child.href)}>
                        <span>{child.label}</span>
                        {child.description && <small>{child.description}</small>}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      {
        school.admissionsOpen && (
          <a href={url('/admissions/')} class="btn btn--gold btn--sm cta">
            <span class="pulse" aria-hidden="true" />
            Admissions {school.admissionSession}
          </a>
        )
      }
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
        <span class="visually-hidden">Open menu</span>
        <Icon name="menu" size={26} />
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
    <div class="mobile-nav-head">
      <span class="brand-name">Menu</span>
      <button type="button" class="menu-close" data-menu-close>
        <span class="visually-hidden">Close menu</span>
        <Icon name="x" size={26} />
      </button>
    </div>
    <nav aria-label="Mobile">
      <ul class="mobile-list">
        {
          mainNav.map((item) =>
            item.children ? (
              <li>
                <details>
                  <summary>
                    {item.label}
                    <Icon name="chevron-down" size={18} />
                  </summary>
                  <ul>
                    {item.children.map((child) => (
                      <li>
                        <a href={url(child.href)} data-close-on-click>
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li>
                <a href={url(item.href)} class="top" data-close-on-click>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
      <ul class="mobile-utility">
        {
          utilityLinks.map((link) => (
            <li>
              <a href={url(link.href)} data-close-on-click>
                <Icon name={link.icon} size={18} />
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="mobile-cta">
      <a href={url('/admissions/#enquiry')} class="btn btn--gold" data-close-on-click>Admission Enquiry</a>
      <div class="btn-row">
        <a href={telLink(school.phones[0])} class="btn btn--outline btn--sm"><Icon name="phone" /> Call</a>
        <a href={whatsappLink()} class="btn btn--whatsapp btn--sm" target="_blank" rel="noopener"
          ><Icon name="whatsapp" /> WhatsApp</a
        >
      </div>
    </div>
  </div>
  <div class="mobile-backdrop" data-menu-backdrop hidden></div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-nav]');
  const backdrop = document.querySelector<HTMLElement>('[data-menu-backdrop]');
  const close = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  function setOpen(open: boolean) {
    if (!panel || !toggle || !backdrop) return;
    toggle.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    backdrop.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) close?.focus();
    else toggle.focus({ preventScroll: true });
  }

  toggle?.addEventListener('click', () => setOpen(true));
  close?.addEventListener('click', () => setOpen(false));
  backdrop?.addEventListener('click', () => setOpen(false));
  panel?.querySelectorAll('[data-close-on-click]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel && !panel.hidden) setOpen(false);
  });

  // Add a shadow once the page has scrolled.
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.96);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line-soft);
    transition: box-shadow 0.2s;
  }
  .site-header.is-scrolled {
    box-shadow: 0 6px 24px -12px rgb(10 31 68 / 0.25);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 20px;
    min-height: var(--header-h);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    min-width: 0;
    margin-right: auto;
  }
  .brand :global(.brand-crest) {
    flex: none;
  }
  .brand-text {
    display: grid;
    min-width: 0;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: clamp(1.05rem, 0.9rem + 0.7vw, 1.35rem);
    line-height: 1.15;
    color: var(--navy-900);
    letter-spacing: -0.01em;
  }
  .brand-sub {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--muted);
    letter-spacing: 0.02em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Desktop nav */
  .nav-desktop > ul {
    display: flex;
    align-items: center;
    gap: 2px;
    list-style: none;
    padding: 0;
  }
  .nav-desktop li {
    position: relative;
  }
  .nav-desktop > ul > li > a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 10px 11px;
    border-radius: 8px;
    font-weight: 750;
    font-size: 0.93rem;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-desktop > ul > li > a:hover,
  .nav-desktop > ul > li:focus-within > a {
    color: var(--navy-900);
    background: var(--navy-50);
  }
  .nav-desktop > ul > li > a[aria-current='page'] {
    color: var(--navy-900);
    box-shadow: inset 0 -2px 0 var(--gold-500);
    border-radius: 8px 8px 0 0;
  }
  .nav-desktop :global(.icon) {
    opacity: 0.6;
    transition: transform 0.2s;
  }
  .has-menu:hover > a :global(.icon),
  .has-menu:focus-within > a :global(.icon) {
    transform: rotate(180deg);
  }
  .menu {
    position: absolute;
    top: calc(100% + 6px);
    left: -8px;
    min-width: 250px;
    padding: 8px;
    list-style: none;
    background: #fff;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity 0.18s,
      transform 0.18s,
      visibility 0.18s;
  }
  .menu::before {
    content: '';
    position: absolute;
    inset: -10px 0 auto;
    height: 10px;
  }
  .has-menu:hover > .menu,
  .has-menu:focus-within > .menu {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .menu a {
    display: grid;
    padding: 9px 12px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--ink);
    font-weight: 700;
    font-size: 0.92rem;
  }
  .menu a small {
    font-weight: 500;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .menu a:hover,
  .menu a:focus-visible {
    background: var(--gold-100);
    color: var(--navy-900);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .cta {
    position: relative;
  }
  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--maroon-600);
    box-shadow: 0 0 0 0 rgb(143 34 50 / 0.6);
    animation: pulse 1.8s infinite;
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 8px rgb(143 34 50 / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(143 34 50 / 0);
    }
  }
  .menu-toggle,
  .menu-close {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
    color: var(--navy-900);
  }
  .menu-toggle {
    display: none;
  }

  /* Mobile drawer */
  .mobile-nav {
    position: fixed;
    inset: 0 0 0 auto;
    z-index: 60;
    width: min(380px, 100%);
    display: flex;
    flex-direction: column;
    background: #fff;
    box-shadow: var(--shadow-lg);
    overflow-y: auto;
    overscroll-behavior: contain;
    animation: slide-in 0.25s ease;
  }
  .mobile-nav[hidden],
  .mobile-backdrop[hidden] {
    display: none;
  }
  @keyframes slide-in {
    from {
      transform: translateX(30px);
      opacity: 0;
    }
  }
  .mobile-backdrop {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: rgb(6 20 48 / 0.5);
  }
  .mobile-nav-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--line-soft);
  }
  .mobile-list,
  .mobile-utility {
    list-style: none;
    padding: 8px 12px;
  }
  .mobile-list > li {
    border-bottom: 1px solid var(--line-soft);
  }
  .mobile-list a.top,
  .mobile-list summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 8px;
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--navy-900);
    text-decoration: none;
    list-style: none;
    cursor: pointer;
  }
  .mobile-list summary::-webkit-details-marker {
    display: none;
  }
  .mobile-list details[open] summary :global(.icon) {
    transform: rotate(180deg);
  }
  .mobile-list details ul {
    list-style: none;
    padding: 0 0 10px 12px;
  }
  .mobile-list details a {
    display: block;
    padding: 9px 8px;
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 600;
  }
  .mobile-utility {
    display: grid;
    gap: 2px;
    padding-top: 12px;
  }
  .mobile-utility a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 8px;
    color: var(--navy-700);
    font-weight: 700;
    text-decoration: none;
  }
  .mobile-cta {
    margin-top: auto;
    padding: 20px;
    display: grid;
    gap: 12px;
    background: var(--cream);
    border-top: 1px solid var(--line-soft);
  }
  .mobile-cta .btn-row > * {
    flex: 1;
  }

  @media (max-width: 1180px) {
    .nav-desktop {
      display: none;
    }
    .menu-toggle {
      display: grid;
    }
  }
  @media (max-width: 560px) {
    .cta {
      display: none;
    }
    .brand-sub {
      white-space: normal;
      font-size: 0.68rem;
      line-height: 1.3;
    }
  }
</style>
