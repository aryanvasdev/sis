---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { school, whatsappLink } from '../data/school';
import { achievements, celebrations } from '../data/achievements';
import { url } from '../lib/url';

const jumpLinks = [
  { label: 'Our wins', href: '#wins' },
  { label: 'Celebrating every child', href: '#celebrate' },
  { label: 'On stage', href: '#stage' },
];
---

<BaseLayout
  title="Achievements"
  description={`Achievements of the students of ${school.name}, ${school.address.city}: sports championships, stage performances and more.`}
>
  <PageHero
    title="Achievements"
    eyebrow="Celebrating our students"
    lead={`On the sports field and on stage, every success of our students from ${school.classes} is worth celebrating.`}
    crumbs={[{ label: 'Campus Life', href: '/facilities/' }, { label: 'Achievements' }]}
  >
    <nav class="jump" aria-label="On this page">
      {
        jumpLinks.map((l) => (
          <a href={l.href} class="jump-link">
            {l.label}
          </a>
        ))
      }
    </nav>
  </PageHero>

  <!-- ========== OUR WINS ========== -->
  <section class="section" id="wins">
    <div class="container">
      <SectionHead eyebrow="Our wins" title="Champions on the track" />
      <div class="wins">
        {
          achievements.map((a) => (
            <article class="win reveal">
              <div class="win-count" aria-hidden={a.count ? undefined : 'true'}>
                <Icon name={a.icon} size={34} />
                {a.count && (
                  <>
                    <span class="win-number">{a.count}</span>
                    <span class="win-unit">{a.countLabel}</span>
                  </>
                )}
              </div>
              <div class="win-body">
                <p class="win-tags">
                  <span class="tag tag--gold">{a.area}</span>
                  <span class="tag">{a.level}</span>
                  {a.year && <span class="tag">{a.year}</span>}
                </p>
                <h3>{a.title}</h3>
                {a.event && <p class="win-event">{a.event}</p>}
                <p>{a.text}</p>
              </div>
            </article>
          ))
        }
      </div>
      <p class="callout callout--navy wins-note reveal">
        <Icon name="info" />
        <span>
          Has your child won a competition, inside or outside school? Tell the class teacher or
          <a href={whatsappLink(`Hello, I would like to share an achievement of my child at ${school.name}.`)} target="_blank" rel="noopener"
            >send us a WhatsApp message</a
          >, so we can celebrate it here.
        </span>
      </p>
    </div>
  </section>

  <!-- ========== CELEBRATING EVERY CHILD ========== -->
  <section class="section section--cream" id="celebrate">
    <div class="container">
      <div class="split split--wide-right">
        <figure class="feature-photo reveal">
          <Photo
            src="images/gallery/cultural-dance/01.jpg"
            alt="Ten students in red and gold dance costumes with ornate headdresses, lined up before their performance at a cultural event"
            ratio="4 / 3"
          />
          <figcaption>Our dance troupe, ready to go on stage</figcaption>
        </figure>
        <div class="reveal">
          <SectionHead
            eyebrow="Celebrating every child"
            title="Every effort counts, not just first prizes"
            lead="A medal is wonderful, but so is the shy child who speaks in assembly for the first time. We make sure every child’s effort is seen and applauded."
          />
          <ul class="celebrate-list">
            {
              celebrations.map((c) => (
                <li>
                  <span class="celebrate-icon">
                    <Icon name={c.icon} size={20} />
                  </span>
                  <span>
                    <strong>{c.title}</strong>
                    <span>{c.text}</span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== ON STAGE ========== -->
  <section class="section" id="stage">
    <div class="container split">
      <div class="reveal">
        <SectionHead
          eyebrow="Dance & culture"
          title="Confidence that starts on stage"
          lead="Dance, music and drama are part of school life from Nursery onwards. Our troupes perform at school festivals and inter-school events, and many children discover a lifelong love of performing."
        />
        <ul class="check-list">
          <li>Folk and classical dance for every age group</li>
          <li>Group singing, poetry recitation and festival programmes</li>
          <li>Skits, role-plays and the Annual Day production</li>
        </ul>
        <div class="btn-row stage-cta">
          <a href={url('/gallery/')} class="btn btn--navy">
            <Icon name="images" /> Photo gallery
          </a>
          <a href={url('/student-life/')} class="btn btn--outline">Student life</a>
        </div>
      </div>
      <figure class="feature-photo reveal">
        <Photo
          src="images/gallery/annual-function/01.jpg"
          alt="Students in black and tiger-striped costumes performing an energetic group dance on the annual function stage"
          ratio="16 / 9"
        />
        <figcaption>On stage at our annual function</figcaption>
      </figure>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero jump links ---------- */
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
  .jump-link {
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.25);
    background: rgb(255 255 255 / 0.06);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 750;
    text-decoration: none;
    transition:
      background 0.2s,
      border-color 0.2s,
      color 0.2s;
  }
  .jump-link:hover {
    background: var(--gold-500);
    border-color: var(--gold-500);
    color: var(--navy-950);
  }

  /* ---------- Feature photos ---------- */
  .feature-photo :global(.photo) {
    box-shadow: var(--shadow-lg);
  }
  .feature-photo figcaption {
    margin-top: 12px;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--muted);
  }

  /* ---------- Celebrating every child ---------- */
  .celebrate-list {
    display: grid;
    gap: 18px;
    list-style: none;
    padding: 0;
  }
  @media (min-width: 640px) {
    .celebrate-list {
      grid-template-columns: 1fr 1fr;
    }
  }
  .celebrate-list li {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .celebrate-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--gold-100);
    color: var(--gold-600);
  }
  .celebrate-list strong {
    display: block;
    color: var(--navy-900);
    line-height: 1.3;
  }
  .celebrate-list li > span:last-child > span {
    display: block;
    margin-top: 2px;
    font-size: 0.92rem;
    color: var(--muted);
  }
  /* ---------- On stage ---------- */
  .stage-cta {
    margin-top: 28px;
  }

  /* ---------- Our wins ---------- */
  .wins {
    display: grid;
    gap: 20px;
  }
  .win {
    display: grid;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  @media (min-width: 720px) {
    .win {
      grid-template-columns: minmax(220px, 0.42fr) 1fr;
    }
  }
  .win-count {
    position: relative;
    isolation: isolate;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 6px;
    padding: 32px 24px;
    background:
      radial-gradient(260px 200px at 100% 0%, rgb(228 185 76 / 0.28), transparent 70%),
      linear-gradient(140deg, var(--navy-900), var(--navy-700));
    color: var(--gold-400);
    text-align: center;
  }
  .win-count::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--jali);
    background-size: 56px 56px;
    opacity: 0.1;
  }
  .win-number {
    font-family: var(--font-display);
    font-size: clamp(3.6rem, 3rem + 3vw, 5.2rem);
    font-weight: 600;
    line-height: 1;
    color: #fff;
  }
  .win-unit {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .win-body {
    padding: clamp(24px, 4vw, 40px);
    align-self: center;
  }
  .win-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }
  .win h3 {
    font-size: var(--step-3);
  }
  .win-event {
    margin-top: 4px;
    font-weight: 700;
    color: var(--navy-700);
  }
  .win-body > p:last-child {
    margin-top: 12px;
    color: var(--ink-soft);
    max-width: 60ch;
  }
  .wins-note {
    margin-top: 28px;
  }
</style>
