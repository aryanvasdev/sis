---
import BaseLayout from '../layouts/BaseLayout.astro';
import Crest from '../components/Crest.astro';
import Icon from '../components/Icon.astro';
import { school, telLink } from '../data/school';
import { url } from '../lib/url';

const actions = [
  { label: 'Home', href: '/', icon: 'house', variant: 'btn--navy' },
  { label: 'Admissions', href: '/admissions/', icon: 'graduation-cap', variant: 'btn--gold' },
  { label: 'Notices', href: '/notices/', icon: 'bell', variant: 'btn--outline' },
  { label: 'Contact', href: '/contact/', icon: 'phone', variant: 'btn--outline' },
];

const popular = [
  { label: 'Fee structure', href: '/admissions/#fees' },
  { label: 'Academic calendar', href: '/academics/#calendar' },
  { label: 'Student Life', href: '/student-life/' },
  { label: 'TC Verification', href: '/tc-verification/' },
  { label: 'Facilities', href: '/facilities/' },
  { label: 'Photo Gallery', href: '/gallery/' },
];
---

<BaseLayout title="Page not found" description={`The page you were looking for could not be found on the ${school.name} website.`}>
  <section class="nf">
    <div class="container nf-inner">
      <p class="nf-code" aria-hidden="true">
        <span>4</span>
        <Crest size={112} class="nf-crest" />
        <span>4</span>
      </p>
      <p class="eyebrow">Error 404</p>
      <h1>Page not found</h1>
      <p class="lead">
        Sorry, we couldn’t find the page you were looking for. It may have been moved, or the link may be out of date.
        These links will help you find your way.
      </p>
      <div class="btn-row">
        {
          actions.map((a) => (
            <a href={url(a.href)} class:list={['btn', a.variant]}>
              <Icon name={a.icon} /> {a.label}
            </a>
          ))
        }
      </div>

      <nav class="nf-popular" aria-label="Popular pages">
        <p class="nf-popular-label">Popular pages</p>
        <ul>
          {
            popular.map((p) => (
              <li>
                <a href={url(p.href)} class="link-arrow">
                  {p.label} <Icon name="arrow-right" />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <p class="nf-help">
        Still can’t find what you need? Call us on <a href={telLink(school.phones[0])}>{school.phones[0]}</a> or email
        <a href={`mailto:${school.email}`}>{school.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(56px, 9vw, 120px);
    background:
      radial-gradient(700px 360px at 50% 0%, rgb(212 161 42 / 0.16), transparent 70%),
      var(--cream);
  }
  .nf::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: var(--jali);
    background-size: 64px 64px;
    opacity: 0.12;
    mask-image: radial-gradient(ellipse at 50% 30%, #000, transparent 75%);
  }
  .nf-inner {
    display: grid;
    justify-items: center;
    text-align: center;
    max-width: 820px;
  }
  .nf-code {
    display: flex;
    align-items: center;
    gap: clamp(10px, 2vw, 18px);
    font-family: var(--font-display);
    font-size: clamp(5rem, 3.6rem + 7vw, 9rem);
    font-weight: 600;
    line-height: 1;
    color: var(--navy-900);
    font-variation-settings: 'opsz' 144, 'SOFT' 50;
    margin-bottom: 22px;
  }
  .nf-code :global(.nf-crest) {
    width: auto;
    height: clamp(72px, 3.4rem + 4vw, 112px);
    filter: drop-shadow(0 12px 18px rgb(10 31 68 / 0.25));
  }
  .eyebrow::after {
    content: '';
    width: 28px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
  }
  h1 {
    margin-top: 12px;
    font-size: var(--step-4);
  }
  .lead {
    margin-inline: auto;
  }
  .btn-row {
    justify-content: center;
    margin-top: 30px;
  }
  .nf-popular {
    width: 100%;
    margin-top: clamp(36px, 5vw, 56px);
    padding: 22px clamp(18px, 3vw, 28px);
    border-radius: var(--radius-lg);
    background: var(--paper);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
  }
  .nf-popular-label {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .nf-popular ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 28px;
    list-style: none;
    padding: 0;
  }
  .nf-popular .link-arrow {
    font-size: 0.95rem;
  }
  .nf-help {
    margin-top: 24px;
    font-size: 0.92rem;
    color: var(--muted);
  }
  .nf-help a {
    font-weight: 700;
    overflow-wrap: anywhere;
  }
</style>
