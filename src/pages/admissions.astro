---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { school, telLink, whatsappLink } from '../data/school';
import {
  admissionYear,
  classesOpen,
  otherClassesNote,
  keyDates,
  admissionOffice,
  ageCutoff,
  ageRules,
  dobRange,
  documents,
  faqs,
} from '../data/admissions';
import {
  showFees,
  feeSession,
  oneTimeCharges,
  classFees,
  tuitionQuarterly,
  yearlyTotal,
  transportSlabs,
  transportNote,
  feeNotes,
} from '../data/fees';
import { formatDate, formatDateLong, formatINR, dateParts } from '../lib/format';
import { url } from '../lib/url';
import { hasPublicFile } from '../lib/files';

const steps = [
  {
    icon: 'messages-square',
    title: 'Enquiry',
    text: 'Fill in the enquiry form below, call or WhatsApp us, or walk in to the admission office. We will answer your questions and invite you for a campus tour.',
  },
  {
    icon: 'file-pen-line',
    title: 'Registration',
    text: 'Collect the registration form from the school office, fill it in and submit it with the registration fee, a photograph and a copy of the birth certificate.',
  },
  {
    icon: 'users',
    title: 'Interaction / assessment',
    text: 'A relaxed, friendly interaction with the child and parents. There is no written test; for Classes II – VIII we also look at the last report card.',
  },
  {
    icon: 'file-check',
    title: 'Document verification & offer',
    text: 'Bring the original documents for verification. Families are then given a provisional admission letter for the seat offered.',
  },
  {
    icon: 'badge-check',
    title: 'Fee payment & confirmation',
    text: 'Complete the fee formalities to confirm the seat. You will receive the book list, uniform details and the date of the first day at school.',
  },
];

/** '2026-12-01' + '2026-12-19' → '1 – 19 Dec 2026' */
const dateRange = (from: string, to?: string) => {
  if (!to) return formatDate(from);
  const a = dateParts(from);
  const b = dateParts(to);
  if (a.month === b.month && a.year === b.year) return `${Number(a.day)} – ${Number(b.day)} ${b.month} ${b.year}`;
  return `${formatDate(from)} – ${formatDate(to)}`;
};

/** Split an email address so it can wrap before the "@" in narrow cards. */
const emailParts = (email: string) => {
  const i = email.indexOf('@');
  return [email.slice(0, i), email.slice(i)];
};

const enquiryMessage = `Hello, I would like to know about admissions for Session ${school.admissionSession}.`;

// Until the prospectus PDF is uploaded to /public/documents/, parents can request it on WhatsApp.
const prospectusReady = hasPublicFile(admissionOffice.prospectus);
const prospectusHref = prospectusReady
  ? url(admissionOffice.prospectus)
  : whatsappLink(`Hello, please send me the prospectus for Session ${school.admissionSession}.`);
const prospectusAttrs = prospectusReady ? { download: true } : { target: '_blank', rel: 'noopener' };
---

<BaseLayout
  title="Admissions"
  description={`Admissions for Session ${school.admissionSession} at ${school.name}, ${school.address.city}, ${school.address.district} (${classesOpen}): admission process, age criteria, documents required, fee structure and FAQs.`}
>
  <PageHero
    title="Admissions"
    eyebrow={`Session ${school.admissionSession}`}
    lead={school.admissionsOpen
      ? `Registrations are open for ${classesOpen}. Everything you need is on this page: the process, age criteria, documents, fees and answers to the questions parents ask us most.`
      : `Everything you need to know about joining ${school.name}: the process, age criteria, documents, fees and answers to the questions parents ask us most.`}
    crumbs={[{ label: 'Admissions' }]}
  >
    <div class="btn-row">
      <a href="#enquiry" class="btn btn--gold">Admission enquiry <Icon name="arrow-right" /></a>
      <a href="#fees" class="btn btn--light">Fee details</a>
    </div>
  </PageHero>

  <!-- ========== INTRO / KEY DATES ========== -->
  {
    school.admissionsOpen ? (
      <section class="section">
        <div class="container intro">
          <div class="reveal">
            <span class="tag tag--maroon">Now open</span>
            <SectionHead eyebrow="Welcome" title={`Admissions open for Session ${school.admissionSession}`} />
            <div class="stack">
              <p>
                Thank you for considering {school.name} for your child. We are now registering students for{' '}
                <strong>{classesOpen}</strong>. {otherClassesNote}
              </p>
              <p>
                Choosing a school is a big decision, so we encourage every family to visit us first: walk through the
                classrooms, meet our teachers and ask as many questions as you like.
              </p>
              <ul class="check-list">
                <li>{school.recognition} school, {school.classes}</li>
                <li>Follows the {school.curriculum}, {school.medium} medium</li>
                <li>No admission test: just a friendly interaction</li>
                <li>Fees explained clearly before you register</li>
              </ul>
              <div class="btn-row" style="margin-top:24px">
                <a href={prospectusHref} class="btn btn--navy" {...prospectusAttrs}>
                  <Icon name={prospectusReady ? 'download' : 'whatsapp'} /> Prospectus {school.admissionSession}
                </a>
                <a href={telLink(school.phones[0])} class="btn btn--outline">
                  <Icon name="phone" /> {school.phones[0]}
                </a>
              </div>
            </div>
          </div>

          <aside class="dates-card reveal" aria-labelledby="dates-title">
            <h3 id="dates-title" class="dates-title">
              <Icon name="calendar-days" /> Key dates
            </h3>
            <ol class="dates">
              {keyDates.map((d) => (
                <li>
                  <time datetime={d.date}>{dateRange(d.date, d.endDate)}</time>
                  <strong>{d.label}</strong>
                  {d.note && <span>{d.note}</span>}
                </li>
              ))}
            </ol>
          </aside>
        </div>
      </section>
    ) : (
      <section class="section section--tight">
        <div class="container">
          <p class="callout callout--navy">
            <Icon name="info" />
            <span>
              Registrations for Session {school.admissionSession} are not open yet. Seats may still be available in some
              classes, so please <a href="#enquiry">send us an enquiry</a> or call {school.phones[0]}.
            </span>
          </p>
        </div>
      </section>
    )
  }

  <!-- ========== PROCESS ========== -->
  <section class="section section--navy section--jali" id="process">
    <div class="container">
      <SectionHead
        eyebrow="Admission process"
        title="Five simple steps"
        lead="Our admission team will guide you at every stage. Most families complete the process within two to three weeks."
      />
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step reveal">
              <span class="step-top">
                <span class="step-icon">
                  <Icon name={s.icon} />
                </span>
                <span class="step-num" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
              </span>
              <h3>
                <span class="visually-hidden">Step {i + 1}: </span>
                {s.title}
              </h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ========== AGE CRITERIA ========== -->
  <section class="section" id="age">
    <div class="container age">
      <div class="reveal">
        <SectionHead
          eyebrow="Age criteria"
          title="Is my child the right age?"
          lead={`For the early years and Class I, a child’s age is counted as on ${formatDateLong(ageCutoff)}.`}
        />
        <div class="table-wrap">
          <table class="table age-table">
            <caption class="visually-hidden">Age criteria for Session {school.admissionSession}</caption>
            <thead>
              <tr>
                <th scope="col">Class</th>
                <th scope="col">Minimum age</th>
                <th scope="col">Date of birth between</th>
              </tr>
            </thead>
            <tbody>
              {
                ageRules.map((r) => {
                  const range = dobRange(r.minAge);
                  return (
                    <tr>
                      <th scope="row">{r.cls}</th>
                      <td>{r.minAge}+ years</td>
                      <td class="dob">
                        <time datetime={range.from}>{formatDate(range.from)}</time> –{' '}
                        <time datetime={range.to}>{formatDate(range.to)}</time>
                      </td>
                    </tr>
                  );
                })
              }
              <tr>
                <th scope="row">Class II onwards</th>
                <td>Age-appropriate</td>
                <td>As per the previous school’s records and TC</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <aside class="card age-notes reveal" aria-labelledby="age-notes-title">
        <span class="icon-badge icon-badge--navy">
          <Icon name="info" />
        </span>
        <h3 id="age-notes-title">Good to know</h3>
        <ul class="check-list">
          <li>
            “{ageRules[0].minAge}+” means the child has completed {ageRules[0].minAge} years on 31 March {admissionYear}.
          </li>
          <li>
            The criteria follow the National Education Policy (NEP) 2020, which places Class I at age 6+, and the norms
            of the Government of {school.address.state}. They may be revised if new orders are issued.
          </li>
          <li>Please bring the child’s original birth certificate at the time of registration.</li>
        </ul>
      </aside>
    </div>
  </section>

  <!-- ========== DOCUMENTS ========== -->
  <section class="section section--cream" id="documents">
    <div class="container">
      <SectionHead
        eyebrow="Documents"
        title="Documents required"
        lead="Please bring one set of self-attested photocopies, along with the originals for verification."
      />
      <ul class="docs">
        {
          documents.map((d) => (
            <li class="doc reveal">
              <span class="doc-icon">
                <Icon name="file-text" size={20} />
              </span>
              <span>
                <strong>{d.title}</strong>
                {d.note && <small>{d.note}</small>}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ========== FEES ========== -->
  <section class="section" id="fees">
    <div class="container">
      {
        showFees ? (
          <>
      <div class="fees-head">
        <SectionHead
          eyebrow={`Fee structure · Session ${feeSession}`}
          title="Fees, clearly explained"
          lead="No hidden charges. Fees are paid quarterly, and every payment is acknowledged with a receipt."
        />
        {
          school.feePaymentUrl && (
            <a href={school.feePaymentUrl} class="btn btn--gold" target="_blank" rel="noopener">
              <Icon name="credit-card" /> Pay fees online
            </a>
          )
        }
      </div>

      <h3 class="fees-sub">One-time charges (new admissions)</h3>
      <div class="grid grid-3 onetime">
        {
          oneTimeCharges.map((c) => (
            <div class="card onetime-card reveal">
              <p class="onetime-label">{c.label}</p>
              <p class="onetime-amount">{formatINR(c.amount)}</p>
              <p class="small">{c.note}</p>
            </div>
          ))
        }
      </div>

      <h3 class="fees-sub">Class-wise fees</h3>
      <p class="scroll-hint small muted" aria-hidden="true">
        Swipe the table sideways to see all columns <Icon name="arrow-right" size={16} />
      </p>
      <div class="table-wrap reveal">
        <table class="table fee-table">
          <caption class="visually-hidden">Class-wise fees for Session {feeSession}</caption>
          <thead>
            <tr>
              <th scope="col">Class</th>
              <th scope="col" class="num">Annual charges</th>
              <th scope="col" class="num">Tuition / month</th>
              <th scope="col" class="num">Tuition / quarter</th>
              <th scope="col" class="num">Total for the year*</th>
            </tr>
          </thead>
          <tbody>
            {
              classFees.map((f) => (
                <tr>
                  <th scope="row">
                    {f.group}
                    {f.detail && <span class="fee-detail">{f.detail}</span>}
                  </th>
                  <td class="num">{formatINR(f.annual)}</td>
                  <td class="num">{formatINR(f.tuitionMonthly)}</td>
                  <td class="num">{formatINR(tuitionQuarterly(f))}</td>
                  <td class="num total">{formatINR(yearlyTotal(f))}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="small muted table-note">
        * Annual charges plus 12 months’ tuition. Does not include one-time charges, transport, books or uniform.
        Annual charges cover development, activities, library and examinations.
      </p>

      <div class="fees-lower">
        <div class="reveal">
          <h3 class="fees-sub">Transport fee (optional)</h3>
          <div class="table-wrap">
            <table class="table transport-table">
              <caption class="visually-hidden">School bus fee by distance</caption>
              <thead>
                <tr>
                  <th scope="col">Distance from school</th>
                  <th scope="col" class="num">Per month</th>
                </tr>
              </thead>
              <tbody>
                {
                  transportSlabs.map((t) => (
                    <tr>
                      <th scope="row">{t.distance}</th>
                      <td class="num">{formatINR(t.monthly)}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="small muted table-note">{transportNote}</p>
        </div>

        <div class="reveal">
          <h3 class="fees-sub">Important notes</h3>
          <dl class="fee-notes">
            {
              feeNotes.map((n) => (
                <div>
                  <dt>{n.title}</dt>
                  <dd>{n.text}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>

          </>
        ) : (
          <>
            <SectionHead
              eyebrow={`Fees · Session ${feeSession}`}
              title="Fee details"
              lead="We share the complete fee structure with every family before registration, so there are no surprises."
            />
            <div class="fee-request reveal">
              <span class="icon-badge">
                <Icon name="indian-rupee" />
              </span>
              <div>
                <h3>Ask us for the fee structure</h3>
                <p>
                  For the class-wise fees for Session {feeSession}, including transport charges, please visit the school
                  office, call us or send a message on WhatsApp. We will be happy to explain every part of it.
                </p>
                <div class="btn-row">
                  <a
                    href={whatsappLink(`Hello, please share the fee structure for Session ${feeSession}. My child is applying for Class: `)}
                    class="btn btn--whatsapp"
                    target="_blank"
                    rel="noopener"
                  >
                    <Icon name="whatsapp" /> Ask on WhatsApp
                  </a>
                  <a href={telLink(school.phones[0])} class="btn btn--outline">
                    <Icon name="phone" /> {school.phones[0]}
                  </a>
                </div>
              </div>
            </div>
          </>
        )
      }

      <aside class="rte reveal" aria-labelledby="rte-title">
        <span class="icon-badge icon-badge--maroon">
          <Icon name="scale" />
        </span>
        <div>
          <h3 id="rte-title">Free seats under the RTE Act</h3>
          <p>
            Under Section 12(1)(c) of the Right of Children to Free and Compulsory Education (RTE) Act, 2009, 25% of seats
            at the entry level are reserved for children from Economically Weaker Sections (EWS) and Disadvantaged Groups
            (DG), who study free of cost. These seats are not applied for at the school: applications are made online
            through the {school.address.state} state admission portal, as notified by the state government each year.
            Please watch for the notification for dates and eligibility, or ask our admission office for help.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <!-- ========== FAQ ========== -->
  <section class="section section--cream" id="faq">
    <div class="container faq-wrap">
      <div class="faq-intro reveal">
        <SectionHead
          eyebrow="FAQs"
          title="Questions parents ask us"
          lead="Can’t find your answer here? Our admission team is happy to help."
        />
        <div class="btn-row">
          <a href={whatsappLink(enquiryMessage)} class="btn btn--whatsapp" target="_blank" rel="noopener">
            <Icon name="whatsapp" /> WhatsApp us
          </a>
          <a href={`mailto:${school.admissionsEmail}`} class="btn btn--outline"><Icon name="mail" /> Email</a>
        </div>
        <Photo
          src="images/campus/classroom.jpg"
          alt="Students in their classroom with their class teacher"
          ratio="4 / 3"
          class="faq-photo"
        />
      </div>
      <div class="faq-list reveal">
        {
          faqs.map((f) => (
            <details class="faq">
              <summary>
                <span>{f.q}</span>
                <Icon name="plus" size={20} class="faq-icon" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========== ENQUIRY ========== -->
  <section class="section" id="enquiry">
    <div class="container enquiry">
      <div class="card enquiry-card reveal">
        <SectionHead
          eyebrow="Admission enquiry"
          title="Tell us about your child"
          lead="Share a few details and our admission team will get back to you with the next steps."
        />
        <EnquiryForm variant="admission" />
      </div>

      <aside class="office reveal" aria-labelledby="office-title">
        <h3 id="office-title">Admission office</h3>
        <ul class="office-list">
          <li>
            <Icon name="phone" size={20} />
            <span>
              <small>Call</small>
              {school.phones.map((p) => <a href={telLink(p)}>{p}</a>)}
            </span>
          </li>
          <li>
            <Icon name="whatsapp" size={20} />
            <span>
              <small>WhatsApp</small>
              <a href={whatsappLink(enquiryMessage)} target="_blank" rel="noopener">Chat with the admission team</a>
            </span>
          </li>
          <li>
            <Icon name="mail" size={20} />
            <span>
              <small>Email</small>
              <a href={`mailto:${school.admissionsEmail}`}>
                {emailParts(school.admissionsEmail)[0]}<wbr />{emailParts(school.admissionsEmail)[1]}
              </a>
            </span>
          </li>
          <li>
            <Icon name="clock" size={20} />
            <span>
              <small>Visiting hours</small>
              {admissionOffice.visitingHours}
            </span>
          </li>
          <li>
            <Icon name="school" size={20} />
            <span>
              <small>Campus tours</small>
              {admissionOffice.campusTours}
            </span>
          </li>
        </ul>
        <a href={prospectusHref} class="prospectus" {...prospectusAttrs}>
          <span class="prospectus-icon">
            <Icon name={prospectusReady ? 'download' : 'whatsapp'} />
          </span>
          <span>
            <strong>{prospectusReady ? 'Download the prospectus' : 'Request the prospectus'}</strong>
            <small>Session {school.admissionSession} · {prospectusReady ? 'PDF' : 'on WhatsApp'}</small>
          </span>
        </a>
        <a href={url('/contact/')} class="link-arrow">Directions &amp; all contacts <Icon name="arrow-right" /></a>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .intro > *,
  .age > *,
  .fees-lower > *,
  .faq-wrap > *,
  .enquiry > * {
    min-width: 0;
  }
  .table tbody tr:last-child th {
    border-bottom: 0;
  }

  /* ---------- Intro ---------- */
  .intro {
    display: grid;
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
  }
  @media (min-width: 900px) {
    .intro {
      grid-template-columns: 1.3fr 1fr;
    }
  }
  .intro .tag {
    margin-bottom: 14px;
  }
  .intro :global(.section-head) {
    margin-bottom: 20px;
  }
  .dates-card {
    position: relative;
    padding: clamp(22px, 3vw, 32px);
    border-radius: var(--radius-lg);
    background: var(--cream);
    border: 1px solid var(--line);
  }
  .dates-card::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 5px;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    background: linear-gradient(90deg, var(--gold-600), var(--gold-400));
  }
  .dates-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--step-2);
    padding-bottom: 14px;
    margin-bottom: 6px;
    border-bottom: 2px solid var(--navy-900);
  }
  .dates-title :global(.icon) {
    color: var(--gold-600);
  }
  .dates {
    list-style: none;
    padding: 0;
  }
  .dates li {
    position: relative;
    display: grid;
    gap: 2px;
    padding: 14px 0 14px 26px;
  }
  .dates li + li {
    border-top: 1px dashed var(--line);
  }
  .dates li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 21px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--gold-500);
    box-shadow: 0 0 0 4px var(--gold-100);
  }
  .dates time {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--maroon-600);
  }
  .dates strong {
    color: var(--navy-900);
    line-height: 1.35;
  }
  .dates span {
    font-size: 0.85rem;
    color: var(--muted);
  }

  /* ---------- Process ---------- */
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 16px;
    list-style: none;
    padding: 0;
  }
  .step {
    position: relative;
    padding: 24px 22px;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.05);
    border: 1px solid rgb(255 255 255 / 0.1);
  }
  .step-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }
  .step-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--gold-500);
    color: var(--navy-950);
  }
  .step-num {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 600;
    line-height: 1;
    color: rgb(255 255 255 / 0.16);
  }
  .step h3 {
    font-size: 1.2rem;
  }
  .step p {
    margin-top: 8px;
    font-size: 0.92rem;
    color: #b9c6df;
  }
  @media (min-width: 1100px) {
    .step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 47px;
      right: -17px;
      width: 18px;
      height: 2px;
      background: var(--gold-500);
      opacity: 0.6;
    }
  }

  /* ---------- Age ---------- */
  .age {
    display: grid;
    gap: clamp(28px, 4vw, 48px);
    align-items: end;
  }
  @media (min-width: 960px) {
    .age {
      grid-template-columns: 1.5fr 1fr;
    }
  }
  .age-table {
    min-width: 0;
  }
  .age-table tbody th {
    font-weight: 800;
    color: var(--navy-900);
  }
  .age-table .dob {
    white-space: nowrap;
  }
  .age-table .dob time {
    white-space: nowrap;
  }
  .age-notes h3 {
    margin-bottom: 14px;
  }
  .age-notes .check-list {
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
  @media (max-width: 480px) {
    .age-table th,
    .age-table td {
      padding: 10px 12px;
      font-size: 0.88rem;
    }
    .age-table thead th {
      white-space: normal;
